{
  "name": "magmpaper-engine",
  "version": "0.1.5",
  "description": "Minimal GLSL live wallpapers for Windows 11",
  "author": "MagmPaperEngine",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:ui": "node test/browser.cjs",
    "test:windows": "electron test/electron-windows.cjs",
    "dist:zip": "electron-builder --win zip --x64",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "com.magmanitos.magmpaper",
    "productName": "MagmPaper",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
