<Window x:Class="MagmPaper.Views.CursorHotspot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Точка клика" Style="{StaticResource AppWindow}" Width="360" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <TextBlock Text="Точка клика" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Нажмите на пиксель, которым курсор должен указывать на экран."
               Style="{StaticResource Muted}" Margin="0,8,0,12"/>
    <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12">
      <Grid x:Name="Surface" ClipToBounds="True" Cursor="Cross" MouseLeftButtonDown="PickPixel" HorizontalAlignment="Center">
        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Canvas IsHitTestVisible="False">
          <Ellipse x:Name="Marker" Width="12" Height="12" Stroke="#18131F" StrokeThickness="2" Fill="#E7CBFF"/>
        </Canvas>
      </Grid>
    </Border>
    <Slider x:Name="XInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Пиксель по горизонтали" ValueChanged="HotspotChanged"/>
    <Slider x:Name="YInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Пиксель по вертикали" ValueChanged="HotspotChanged"/>
    <UniformGrid Columns="2" Margin="0,16,0,0">
      <Button Content="Отмена" Margin="0,0,5,0" IsCancel="True"/>
      <Button Content="Установить" Margin="5,0,0,0" IsDefault="True" Style="{StaticResource Primary}" Click="AcceptClick"/>
    </UniformGrid>
  </StackPanel>
</Window>
