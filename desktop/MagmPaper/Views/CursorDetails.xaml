<UserControl x:Class="MagmPaper.Views.CursorDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,0">
      <Button x:Name="BackButton" Content="← К коллекции" Click="BackClick" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <TextBlock x:Name="TitleText" Style="{StaticResource Title}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="226"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Состояния курсора" FontWeight="SemiBold" Margin="6,3,6,10"/>
            <ListBox x:Name="Roles" Height="340" VerticalAlignment="Top" DisplayMemberPath="Label"
                     SelectionChanged="RoleChanged" AutomationProperties.Name="Состояния курсора"/>
          </DockPanel>
        </Border>
        <StackPanel x:Name="Editor" Grid.Column="2">
          <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock x:Name="RoleTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="RoleFile" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" Margin="0,4,0,12"/>
              <Border x:Name="HoverArea" Height="294" CornerRadius="9" Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Image x:Name="RoleImage" Width="96" Height="96" Visibility="Collapsed" Margin="0,0,0,13"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="HoverText" Style="{StaticResource Muted}" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <WrapPanel x:Name="EditActions" Margin="0,12,0,0">
            <Button x:Name="ChooseFileButton" Content="Выбрать файл…" Click="ChooseFileClick"
                    Style="{StaticResource Primary}" Margin="0,0,8,6"/>
            <Button x:Name="ResetButton" Content="Вернуть стандартный курсор" Click="ResetClick" IsEnabled="False"
                    AutomationProperties.Name="Сбросить выбранное состояние" Margin="0,0,0,6"/>
          </WrapPanel>
          <TextBlock x:Name="FormatHint" Text="CUR и ANI сохраняют свою точку клика. Для PNG до 256×256 её можно указать вручную."
                     Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
          <TextBlock x:Name="Feedback" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
