<UserControl x:Class="MagmPaper.Views.CursorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MagmPaper.Views">
  <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="GalleryScrolled">
      <StackPanel>
        <TextBlock Text="Курсоры" Style="{StaticResource Title}"/>
        <TextBlock Text="Наведите курсор, чтобы увидеть состояния. Нажмите на плитку, чтобы открыть подробности." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        <WrapPanel Margin="0,0,0,15">
          <Button Content="Импорт ZIP" Click="ImportZipClick" Margin="0,0,8,4"/>
          <Button Content="Импорт папки" Click="ImportFolderClick" Margin="0,0,8,4"/>
          <Button x:Name="RestoreButton" Content="Вернуть прежнюю схему" Click="RestoreClick" IsEnabled="False" Margin="0,0,0,4"/>
        </WrapPanel>
        <ItemsControl x:Name="Gallery" SizeChanged="GalleryResized" AutomationProperties.Name="Наборы курсоров">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Tile" Style="{StaticResource Card}" Padding="9" Margin="0,0,12,12"
                      MouseEnter="TileEntered" MouseLeave="TileLeft">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <views:CursorTilePreview x:Name="Preview" Frames="{Binding Frames}"/>
                  <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="3,9,3,8" FontWeight="SemiBold"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  <Button x:Name="Open" Grid.RowSpan="2" Click="OpenTileClick" ToolTip="{Binding Name}"
                          AutomationProperties.Name="{Binding Name}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate>
                    </Button.Template>
                  </Button>
                  <WrapPanel x:Name="PackActions" Grid.Row="2">
                    <Button Content="Установить" Style="{StaticResource Primary}" Click="InstallPackClick" FontSize="12" Padding="8,6"
                            Margin="0,0,5,2" AutomationProperties.Name="{Binding Name, StringFormat='Установить {0}'}"/>
                    <Button Content="Автор ↗" Click="SourceClick" FontSize="12" Padding="8,6" Margin="0,0,0,2"
                            ToolTip="Релиз автора · GNU GPL v3" AutomationProperties.Name="{Binding Name, StringFormat='Релиз автора {0}'}"/>
                  </WrapPanel>
                  <Button x:Name="Edit" Grid.Row="2" Content="Настроить состояния" HorizontalAlignment="Left" FontSize="12" Padding="8,6"
                          Click="OpenTileClick" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Pack}" Value="{x:Null}">
                  <Setter TargetName="PackActions" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="Edit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <ContentControl x:Name="DetailsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</UserControl>
