<UserControl x:Class="MagmPaper.Views.CursorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Курсоры" Style="{StaticResource Title}"/>
      <TextBlock Text="Выберите готовый набор или назначьте свой файл каждому состоянию указателя Windows."
                 Style="{StaticResource Muted}" Margin="0,0,0,20"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Готовые наборы" FontSize="20" FontWeight="SemiBold"/>
          <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Установить набор" Click="InstallPackClick"
                    Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox x:Name="Packs" AutomationProperties.Name="Готовый набор курсоров">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Релиз автора ↗" Click="SourceClick" Padding="8,5" Margin="8,0,0,0"/>
            <TextBlock Text="Первая установка загружает набор из релиза автора. Лицензия GNU GPL v3." Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          </DockPanel>
          <WrapPanel Margin="0,14,0,0">
            <Button Content="Импорт ZIP" Click="ImportZipClick" Margin="0,0,8,4"/>
            <Button Content="Импорт папки" Click="ImportFolderClick" Margin="0,0,8,4"/>
            <Button x:Name="RestoreButton" Content="Вернуть прежнюю схему" Click="RestoreClick" IsEnabled="False" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock Text="ZIP и папки меняют состояния с распознанными именами файлов. Остальные можно назначить вручную."
                     Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="Roles" MaxHeight="365" VerticalAlignment="Top" DisplayMemberPath="Label"
                   SelectionChanged="RoleChanged" AutomationProperties.Name="Состояния курсора"/>
          <StackPanel Grid.Column="2">
            <TextBlock x:Name="RoleTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="RoleFile" Style="{StaticResource Muted}" Margin="0,5,0,12"/>
            <Border x:Name="HoverArea" Height="110" CornerRadius="10" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
              <TextBlock x:Name="HoverText" Text="Наведите сюда курсор для проверки" TextAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Button Content="Выбрать файл…" Click="ChooseFileClick" Style="{StaticResource Primary}" Margin="0,12,0,8"/>
            <Button x:Name="ResetButton" Content="Стандартный курсор для этого состояния" Click="ResetClick" IsEnabled="False"
                    AutomationProperties.Name="Сбросить выбранное состояние">
              <Button.ContentTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/></DataTemplate>
              </Button.ContentTemplate>
            </Button>
            <TextBlock Text="CUR и ANI сохраняют свою точку клика. Для PNG до 256×256 её можно указать вручную."
                       Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
