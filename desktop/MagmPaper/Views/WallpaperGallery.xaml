<UserControl x:Class="MagmPaper.Views.WallpaperGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="OpenTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="ViewportChanged" SizeChanged="ViewportResized">
      <ItemsControl x:Name="Tiles">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Tile" Background="{DynamicResource PanelBrush}" CornerRadius="12" Margin="0,0,14,16"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8"
                    MouseEnter="TileEnter" MouseLeave="TileLeave">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border x:Name="Screen" Height="{Binding PreviewHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CornerRadius="7" Background="#141421" ClipToBounds="True">
                  <Grid>
                    <TextBlock Text="{Binding PreviewStatus}" Foreground="#C9C3D9" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Margin="12"/>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Item.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="4,9,4,1"/>
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="4,1,4,4"/>
                <Button Grid.RowSpan="3" Style="{StaticResource OpenTile}" Click="OpenClick"
                        AutomationProperties.Name="{Binding Item.Name}"/>
                <Border x:Name="Actions" CornerRadius="7" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Background="{DynamicResource PanelBrush}" Padding="3" Margin="5" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Primary}" Content="Установить" AutomationProperties.Name="Установить на рабочий стол"
                            FontSize="11" Padding="6,5" Margin="0,0,3,0" Click="ApplyClick"/>
                    <Button Content="Стоп" AutomationProperties.Name="Остановить обои" ToolTip="Остановить обои"
                            IsEnabled="{Binding Active}" FontSize="11" Padding="6,5" Margin="0,0,3,0" Click="StopClick"/>
                    <Button Content="Удалить" AutomationProperties.Name="Удалить обои" FontSize="11" Padding="6,5" Click="DeleteClick"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
              </Trigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="Empty" Text="Коллекция пуста. Добавьте обои, чтобы увидеть их здесь."
               Style="{StaticResource Muted}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,60"/>
  </Grid>
</UserControl>
