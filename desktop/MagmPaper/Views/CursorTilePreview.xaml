<UserControl x:Class="MagmPaper.Views.CursorTilePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False">
  <Border CornerRadius="8" Background="{DynamicResource InputBrush}" Padding="6,8" ClipToBounds="True">
    <Grid Height="101">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="23"/></Grid.RowDefinitions>
      <Image x:Name="Outgoing" Width="64" Height="64" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <Image x:Name="Incoming" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
      </Image>
      <TextBlock x:Name="Caption" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
    </Grid>
  </Border>
</UserControl>
