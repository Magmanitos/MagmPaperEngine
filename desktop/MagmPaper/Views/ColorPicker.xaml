<Window x:Class="MagmPaper.Views.ColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Цвет панели задач" Style="{StaticResource AppWindow}" Width="420" Height="570" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="24">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20" MouseLeftButtonDown="DragTitle"><Button Content="×" DockPanel.Dock="Right" IsCancel="True" Padding="10,4"/><StackPanel><TextBlock Text="Цвет панели" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Оттенок, насыщенность и яркость" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <StackPanel Grid.Row="1">
    <Grid x:Name="Spectrum" Height="210" ClipToBounds="True" Focusable="True" Cursor="Cross" MouseLeftButtonDown="SpectrumDown" MouseMove="SpectrumMove" MouseLeftButtonUp="SpectrumUp" KeyDown="SpectrumKey" SizeChanged="SpectrumResize" ToolTip="Стрелки меняют насыщенность и яркость">
     <Border x:Name="HueBackground"/>
     <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Canvas IsHitTestVisible="False"><Grid x:Name="Marker" Width="14" Height="14"><Ellipse Stroke="Black" StrokeThickness="3"/><Ellipse Stroke="White" StrokeThickness="1.5"/></Grid></Canvas>
    </Grid>
    <Slider x:Name="Hue" Minimum="0" Maximum="360" Height="28" Margin="0,12,0,12" IsMoveToPointEnabled="True" ValueChanged="HueChanged" AutomationProperties.Name="Оттенок">
     <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red"/><GradientStop Color="Yellow" Offset="0.167"/><GradientStop Color="Lime" Offset="0.333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.667"/><GradientStop Color="Magenta" Offset="0.833"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Slider.Background>
     <Slider.Template><ControlTemplate TargetType="Slider"><Grid><Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}" VerticalAlignment="Center"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F4F0FF" BorderBrush="#383143" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Slider.Template>
    </Slider>
    <DockPanel><Border x:Name="Swatch" Width="44" CornerRadius="7" Margin="0,0,12,0" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"/><TextBox x:Name="Hex" MaxLength="7" TextChanged="HexChanged" AutomationProperties.Name="Цвет HEX" FontFamily="Consolas"/></DockPanel>
    <UniformGrid x:Name="Presets" Columns="8" Margin="0,14,0,0"/>
    <TextBlock x:Name="Hint" Text="Непрозрачность настраивается отдельно." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
   </StackPanel>
   <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Отмена" IsCancel="True"/><Button x:Name="Accept" Grid.Column="2" Content="Выбрать цвет" IsDefault="True" Style="{StaticResource Primary}" Click="AcceptClick"/></Grid>
  </Grid>
 </Border>
</Window>
