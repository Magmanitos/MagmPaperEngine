<Window x:Class="MagmPaper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:graphics="clr-namespace:MagmPaper.Graphics" xmlns:views="clr-namespace:MagmPaper.Views"
 Title="MagmPaper" Style="{StaticResource AppWindow}" Width="1280" Height="850" MinWidth="980" MinHeight="650" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="#14151D">
   <TextBlock Text="◈   MagmPaper" Margin="20,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"/>
    <Button Click="MaximizeClick" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
       <Setter Property="Content" Value="&#xE922;"/>
       <Setter Property="ToolTip" Value="Развернуть"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
         <Setter Property="Content" Value="&#xE923;"/>
         <Setter Property="ToolTip" Value="Восстановить размер окна"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="HideClick" ToolTip="Свернуть в трей" AutomationProperties.Name="Свернуть в трей"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#14151B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="22,32,20,26"><TextBlock Text="MagmPaper" FontSize="24" FontWeight="Bold"/><TextBlock Text="ВАШ WINDOWS" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,20,20,24"><TextBlock x:Name="AppVersionLabel" FontSize="11" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Закрытие окна оставляет обои и оформление в трее." Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel>
    <StackPanel><TextBlock Text="ПЕРСОНАЛИЗАЦИЯ" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="26,6,0,12"/>
     <RadioButton x:Name="NavOverview" Content="◫     Обзор" Style="{StaticResource Nav}" GroupName="Navigation" Tag="overview" Click="NavigateClick"/>
     <RadioButton x:Name="NavWallpapers" Content="◈     Обои" Style="{StaticResource Nav}" GroupName="Navigation" Tag="wallpapers" Click="NavigateClick"/>
     <RadioButton x:Name="NavTaskbar" Content="▰     Панель задач" Style="{StaticResource Nav}" GroupName="Navigation" Tag="taskbar" Click="NavigateClick"/>
     <RadioButton x:Name="NavCursors" Content="↖     Курсоры" Style="{StaticResource Nav}" GroupName="Navigation" Tag="cursors" Click="NavigateClick"/>
     <RadioButton x:Name="NavSettings" Content="⚙     Параметры" Style="{StaticResource Nav}" GroupName="Navigation" Tag="settings" Click="NavigateClick" Margin="10,24,10,3"/>
    </StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,24,28,16" x:Name="PageContainer">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="ВАШЕ ЛИЧНОЕ ПРОСТРАНСТВО" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><TextBlock Text="Windows в вашем стиле" Style="{StaticResource Title}"/><TextBlock Text="Обои, панель задач и общие настройки в одном месте." Style="{StaticResource Muted}" Margin="0,0,0,28"/>
     <Border Style="{StaticResource Card}" Padding="30"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#302640"/><GradientStop Color="#1A1E2D" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="Больше пространства&#10;для ваших идей." FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Создайте живой фон и подберите оформление стандартной панели Windows." Style="{StaticResource Muted}" Margin="0,18,0,24"/><Button Content="Открыть коллекцию  ↗" Style="{StaticResource Primary}" HorizontalAlignment="Left" Tag="wallpapers" Click="NavigateClick"/></StackPanel></Border>
     <UniformGrid Columns="2" Margin="0,22,0,0"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="◈  Живые обои" FontSize="20"/><TextBlock x:Name="CollectionCount" Text="Ваша коллекция GLSL" Style="{StaticResource Muted}" Margin="0,14,0,18"/><Button Content="Коллекция и редактор" Tag="wallpapers" Click="NavigateClick" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="▰  Панель задач" FontSize="20"/><TextBlock Text="Размеры, цвет, прозрачность и поведение." Style="{StaticResource Muted}" Margin="0,14,0,18"/><Button Content="Настроить панель" Tag="taskbar" Click="NavigateClick" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid>
     <TextBlock Text="Предпросмотр приостанавливается, когда вы его не видите. Параметры экономии ресурсов доступны в настройках." Style="{StaticResource Muted}" Margin="0,26,0,0"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="WallpapersPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,18"><TextBlock Text="Ваша коллекция" Style="{StaticResource Title}"/><TextBlock Text="Добавляйте GLSL-обои, проверяйте код и выбирайте настроение рабочего стола." Style="{StaticResource Muted}"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><DockPanel>
       <Button x:Name="AddWallpaperButton" DockPanel.Dock="Top" Content="＋  Добавить обои" Click="AddWallpaperClick" Style="{StaticResource Primary}" Margin="0,0,0,12"/>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="📁  Папка обоев" Click="OpenFolderClick" ToolTip="Открыть GLSL-файлы в Проводнике"/><Button Content="↻  Обновить коллекцию" Click="RefreshClick" Margin="0,8,0,0"/></StackPanel>
       <ListBox x:Name="WallpaperList" SelectionChanged="SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border>
      <ScrollViewer x:Name="WallpaperScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock x:Name="WallpaperTitle" Text="Выберите обои" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <Border BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="#08090E" Height="235"><graphics:PreviewHost x:Name="Preview"/></Border>
       <TextBlock x:Name="PauseText" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,8"/>
       <WrapPanel Margin="0,0,0,14"><Button x:Name="ApplyWallpaperButton" Content="На рабочий стол" Style="{StaticResource Primary}" Click="ApplyWallpaperClick" Margin="0,0,8,6"/><Button Content="Остановить" Click="StopWallpaperClick" Margin="0,0,8,6"/><Button x:Name="EditWallpaperButton" Content="Изменить" Click="EditWallpaperClick" Margin="0,0,8,6"/><Button x:Name="DeleteWallpaperButton" Content="Удалить" Click="DeleteWallpaperClick" Margin="0,0,0,6"/></WrapPanel>
       <StackPanel x:Name="EditorPanel" Visibility="Collapsed"><TextBlock x:Name="EditorTitle" Text="Редактор GLSL" FontSize="20" Margin="0,0,0,10"/><TextBox x:Name="NameInput" MaxLength="80" TextChanged="EditorChanged" ToolTip="Название обоев" Margin="0,0,0,10"/><TextBox x:Name="CodeInput" FontFamily="Cascadia Mono,Consolas" FontSize="12" Height="235" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="EditorChanged" SpellCheck.IsEnabled="False"/><WrapPanel Margin="0,12,0,0"><Button x:Name="PreviewCodeButton" Content="Проверить код" Click="PreviewCodeClick" Margin="0,0,8,0"/><Button x:Name="SaveWallpaperButton" Content="Сохранить" Style="{StaticResource Primary}" Click="SaveWallpaperClick" Margin="0,0,8,0"/><Button Content="Отмена" Click="CancelEditorClick"/></WrapPanel></StackPanel>
       <TextBlock x:Name="ShaderHint" Text="Шейдеры GLSL Sandbox: time, resolution, mouse, backbuffer. Предпросмотр реагирует на мышь." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="TaskbarPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Панель задач" Style="{StaticResource Title}"/><TextBlock Text="Настройте стандартную панель Windows. Закреплённые приложения, трей и меню сохраняются." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20"><StackPanel><TextBlock Text="Предпросмотр оформления" FontSize="14" Margin="0,0,0,10"/><Viewbox Height="110" Stretch="Uniform"><Grid Width="620" Height="110" Background="#302442"><Border x:Name="TaskbarSample" VerticalAlignment="Bottom" Height="48" Background="#171923"><Grid><TextBlock x:Name="WidgetsSample" Text="☁  12°" VerticalAlignment="Center" Margin="12,0" FontSize="12"/><StackPanel x:Name="TaskbarSampleIcons" Orientation="Horizontal" HorizontalAlignment="Center">
       <Border><Border CornerRadius="4" Background="#53A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Border><Border CornerRadius="4" Background="#EABB58" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Border><Border CornerRadius="4" Background="#6CC9B0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Border><Border CornerRadius="4" Background="#C295EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </StackPanel><TextBlock Text="12:00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" FontSize="12"/></Grid></Border></Grid></Viewbox><TextBlock Text="При включённом оформлении изменения сразу видны и на панели Windows." Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel>
       <TextBlock Text="Поведение панели" FontSize="21" Margin="0,0,0,10"/><TextBlock Text="Настройки сохраняются в Windows и действуют после выхода из приложения." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
       <TextBlock Text="Расположение кнопок"/><ComboBox x:Name="AlignmentInput" Tag="alignment" SelectionChanged="BehaviorChanged"><ComboBoxItem Content="Слева"/><ComboBoxItem Content="По центру"/></ComboBox>
       <TextBlock Text="Поиск"/><ComboBox x:Name="SearchInput" Tag="search" SelectionChanged="BehaviorChanged"><ComboBoxItem Content="Скрыт"/><ComboBoxItem Content="Значок"/><ComboBoxItem Content="Поле поиска"/><ComboBoxItem Content="Значок и подпись"/></ComboBox>
       <CheckBox x:Name="AutoHideInput" Tag="autoHide" Click="BehaviorChanged" Content="Автоматически скрывать панель"/><CheckBox x:Name="TaskViewInput" Tag="taskView" Click="BehaviorChanged" Content="Кнопка «Представление задач»"/>
       <Button Content="Вернуть исходные" Click="RestoreBehaviorClick" Margin="0,16,0,0"/>
       <Button Content="Открыть параметры Windows  ↗" Click="OpenWindowsClick" Margin="0,20,0,0"/>
       <TextBlock Text="Кнопку виджетов можно скрыть в оформлении справа. Включение самой функции виджетов доступно в параметрах Windows." Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Оформление панели" FontSize="21"/><TextBlock x:Name="AppearanceStatus" Style="{StaticResource Muted}" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite"/><CheckBox x:Name="AppearanceEnabled" Click="AppearanceChanged" Content="Включить оформление MagmPaper"/>
       <Slider x:Name="HeightInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Высота панели, px" Minimum="32" Maximum="96" Value="48" ValueChanged="AppearanceChanged"/>
       <Slider x:Name="IconInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Размер значков, px" Minimum="16" Maximum="64" Value="24" ValueChanged="AppearanceChanged"/>
       <Slider x:Name="ButtonInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Ширина кнопок, px" Minimum="28" Maximum="100" Value="44" ValueChanged="AppearanceChanged"/>
       <DockPanel Margin="0,10,0,4">
        <Button x:Name="ColorButton" DockPanel.Dock="Right" Click="ColorClick" AutomationProperties.Name="Выбрать цвет фона" Padding="9,6">
         <StackPanel Orientation="Horizontal">
          <Border x:Name="ColorSwatch" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Margin="0,0,7,0"/>
          <TextBlock x:Name="ColorValue" Text="#171923"/>
         </StackPanel>
        </Button>
        <TextBlock Text="Цвет фона" VerticalAlignment="Center" Margin="0,0,8,0"/>
       </DockPanel>
       <CheckBox x:Name="GlassInput" Content="Стеклянный градиент" Click="AppearanceChanged"/>
       <DockPanel x:Name="GlassColors" Visibility="Collapsed" Margin="0,2,0,6">
        <Button DockPanel.Dock="Right" Click="GlassColorClick" AutomationProperties.Name="Выбрать второй цвет градиента" Padding="9,6">
         <StackPanel Orientation="Horizontal">
          <Border x:Name="GlassSwatch" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Margin="0,0,7,0"/>
          <TextBlock x:Name="GlassColorValue" Text="#715CD4"/>
         </StackPanel>
        </Button>
        <TextBlock Text="Второй цвет" VerticalAlignment="Center" Margin="0,0,8,0"/>
       </DockPanel>
       <Slider x:Name="OpacityInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Непрозрачность, %" Minimum="0" Maximum="100" Value="80" ValueChanged="AppearanceChanged"/>
       <Slider x:Name="RadiusInput" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Скругление фона, px" Minimum="0" Maximum="24" Value="0" ValueChanged="AppearanceChanged"/>
       <CheckBox x:Name="HideWidgetsInput" Click="AppearanceChanged" Content="Скрыть кнопку виджетов"/>
       <UniformGrid Columns="3" Margin="0,10,0,12" TextElement.FontSize="12">
        <Button Content="Компактная" Tag="compact" Click="PresetClick" Padding="4,8" Margin="0,0,4,0"/>
        <Button Content="Обычная" Tag="standard" Click="PresetClick" Padding="4,8" Margin="2,0"/>
        <Button Content="Крупная" Tag="large" Click="PresetClick" Padding="4,8" Margin="4,0,0,0"/>
       </UniformGrid>
       <TextBlock Text="При 0% фон полностью прозрачный. Размеры указаны до масштабирования Windows. Оформление работает, пока MagmPaper запущен, включая режим в трее." Style="{StaticResource Muted}" FontSize="12"/>
      </StackPanel></Border>
     </Grid>
     <Expander x:Name="LegacyPanel" Header="Прежние настройки Windhawk" Visibility="Collapsed" Foreground="{StaticResource TextBrush}" Margin="0,24,0,0"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="Для записи настроек Windhawk требуется подтверждение администратора. Не включайте оформление MagmPaper одновременно с модами панели Windhawk." Style="{StaticResource Muted}"/>
      <UniformGrid Columns="2" Margin="0,10,0,14">
       <Slider x:Name="LegacyHeight" Style="{StaticResource SettingsSlider}" Margin="0,6,12,2" AutomationProperties.Name="Высота панели, px" Minimum="32" Maximum="96" Value="48"/>
       <Slider x:Name="LegacyIcon" Style="{StaticResource SettingsSlider}" Margin="0,6,12,2" AutomationProperties.Name="Размер значков, px" Minimum="16" Maximum="64" Value="24"/>
       <Slider x:Name="LegacyButton" Style="{StaticResource SettingsSlider}" Margin="0,6,12,2" AutomationProperties.Name="Ширина кнопок, px" Minimum="28" Maximum="100" Value="44"/>
       <Slider x:Name="LegacySmallIcon" Style="{StaticResource SettingsSlider}" Margin="0,6,12,2" AutomationProperties.Name="Размер малых значков, px" Minimum="16" Maximum="32" Value="16"/>
       <Slider x:Name="LegacySmallButton" Style="{StaticResource SettingsSlider}" Margin="0,6,12,2" AutomationProperties.Name="Ширина малых кнопок, px" Minimum="24" Maximum="64" Value="32"/>
      </UniformGrid>
      <WrapPanel><Button Content="Применить через Windhawk" Click="ApplyLegacyClick" Margin="0,0,10,0"/><Button Content="Вернуть прежние размеры" Click="RestoreLegacyClick" Margin="0,0,10,0"/><Button Content="Страница мода ↗" Click="LegacyHelpClick"/></WrapPanel>
     </StackPanel></Border></Expander>
     <Button Content="↻ Обновить состояние панели" Click="RefreshTaskbarClick" HorizontalAlignment="Left" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer>
    <views:CursorPage x:Name="CursorsPage" Visibility="Collapsed"/>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="Параметры приложения" Style="{StaticResource Title}"/><TextBlock Text="Удобный запуск и контроль нагрузки на компьютер." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Запуск и взаимодействие" FontSize="21" Margin="0,0,0,12"/><CheckBox x:Name="StartupInput" Content="Запускать с Windows" Click="StartupClick"/><TextBlock Text="При входе в Windows восстановятся последние обои и сохранённое оформление панели." Style="{StaticResource Muted}" FontSize="12"/><CheckBox x:Name="MouseInput" Content="Реакция обоев на мышь" Click="PlaybackChanged" Margin="0,20,0,9"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Производительность" FontSize="21" Margin="0,0,0,12"/><CheckBox x:Name="CoveredInput" Content="Пауза, когда рабочий стол закрыт окном" Click="PlaybackChanged"/><CheckBox x:Name="BatteryInput" Content="Пауза при работе от батареи" Click="PlaybackChanged"/>
      <TextBlock Text="Частота кадров обоев" Margin="0,16,0,0"/><ComboBox x:Name="FpsInput" SelectionChanged="PlaybackChanged"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/><ComboBoxItem Content="120 FPS" Tag="120"/><ComboBoxItem Content="144 FPS" Tag="144"/><ComboBoxItem Content="165 FPS" Tag="165"/><ComboBoxItem Content="240 FPS" Tag="240"/><ComboBoxItem x:Name="MonitorFpsOption" Content="По частоте монитора" Tag="0"/></ComboBox>
      <TextBlock Text="Качество рендера"/><ComboBox x:Name="QualityInput" SelectionChanged="PlaybackChanged"><ComboBoxItem Content="50% · меньше нагрузка" Tag="0.5"/><ComboBoxItem Content="75% · баланс" Tag="0.75"/><ComboBoxItem Content="100% · максимальная чёткость" Tag="1"/></ComboBox>
      <TextBlock Text="Частота обоев не меняет частоту дисплея Windows. Для экономии оставьте 30–60 FPS; для более плавной анимации выберите частоту монитора. На паузе кадры не рисуются и мышь не опрашивается. Скрытый предпросмотр также приостанавливается. Снижение качества сохраняет заполнение всего экрана." Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel></Border>
     <TextBlock Text="Настройки сохраняются сразу. Коллекция и резервные копии находятся в папке MagmPaper в AppData." Style="{StaticResource Muted}" Margin="0,24,0,0"/>
     <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
       <TextBlock Text="Оформление окон" FontSize="21" Margin="0,0,0,6"/>
       <CheckBox x:Name="WindowBlurInput" Content="Размытый контур вокруг окон" Click="WindowBlurChanged"/>
       <StackPanel x:Name="WindowBlurControls" Visibility="Collapsed">
        <DockPanel Margin="0,8,0,4">
         <Button DockPanel.Dock="Right" Padding="9,6" Click="WindowBlurColorClick" AutomationProperties.Name="Выбрать цвет контура">
          <StackPanel Orientation="Horizontal">
           <Border x:Name="WindowBlurSwatch" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Margin="0,0,7,0"/>
           <TextBlock x:Name="WindowBlurColorValue" Text="#A78BFA"/>
          </StackPanel>
         </Button>
         <TextBlock Text="Цвет контура" VerticalAlignment="Center"/>
        </DockPanel>
        <Slider x:Name="WindowBlurRadius" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Радиус размытия, px"
                Minimum="6" Maximum="72" Value="30" ValueChanged="WindowBlurChanged"/>
        <Slider x:Name="WindowBlurIntensity" Style="{StaticResource SettingsSlider}" AutomationProperties.Name="Интенсивность, %"
                Minimum="0" Maximum="100" Value="42" ValueChanged="WindowBlurChanged"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
       <TextBlock Text="Обновления" FontSize="21" Margin="0,0,0,6"/>
       <CheckBox x:Name="ShowUpdateNotesInput" Content="Показывать список изменений при запуске" Click="ShowUpdateNotesChanged"/>
       <Button x:Name="OpenUpdateNotesButton" Content="Что нового" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenUpdateNotesClick"/>
      </StackPanel>
     </Border>
     <Button Content="Скопировать диагностику" Click="CopyDiagnosticsClick" HorizontalAlignment="Left" Margin="0,18,0,0" ToolTip="Состояние рабочего стола и рендерера для разбора проблем"/>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#14151D" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10"><DockPanel><ProgressBar x:Name="BusyIndicator" DockPanel.Dock="Right" Width="80" Height="3" IsIndeterminate="False" Visibility="Collapsed" Margin="14,0,0,0"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Готово" FontSize="12" Foreground="{StaticResource MutedBrush}" MaxHeight="80"/></DockPanel></Border>
 </Grid></Border>
</Window>
