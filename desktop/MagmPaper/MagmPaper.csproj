<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MagmPaper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../build/icon.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Product>MagmPaper</Product>
    <Description>Native Windows customization and GLSL wallpapers</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MagmPaper.Core/MagmPaper.Core.csproj" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" />
    <Content Include="../../native/bin/MagmTaskbar.dll" Link="taskbar/MagmTaskbar.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../native/bin/MagmTaskbar.dll')" />
    <Content Include="../../native/bin/MagmTaskbarHost.exe" Link="taskbar/MagmTaskbarHost.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../native/bin/MagmTaskbarHost.exe')" />
    <Content Include="../ThirdParty/ANGLE-LICENSE.txt" Link="Licenses/ANGLE.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../build/icon.ico" Link="Assets/icon.ico" />
    <EmbeddedResource Include="Assets/example.glsl" />
  </ItemGroup>
</Project>
